# Pinned inputs for the sparkrun TensorFold DeepSeek-V4.1 community image.
#
# This lane is a fork, not the upstream release: the ARM of the engine that
# serves DeepSeek-V4.1 was written by bertholomus and adapted for the TP2/TP4
# DGX Spark deployment by tonyd2wild.  The full SHA is the reproducibility
# anchor every other number here follows.
#
# docker/tensorfold-dsv41/Dockerfile consumes these as build args,
# docker/tensorfold-dsv41/build.sh sources them, and
# tests/test_tensorfold_image.py keeps the platform default in step.

IMAGE_REPO=ghcr.io/spark-arena/tensorfold-dsv41
TF_FORK_SHA=3ff3b2ac1d71a789cb930068c46d9abed025eefa
IMAGE_TAG=3ff3b2a

# Second, equally supported lane: four patches on the 2D-split TP4 branch.
# Both images are built from the same Dockerfile with PATCH_SET=tp4 and this
# commit; the platform default stays on the TP2 tag and the TP4 recipe names
# its container explicitly.
TF_FORK_SHA_TP4=59402086381a42c74d53053443224eec2790b4c5
IMAGE_TAG_TP4=5940208

# Build inputs.  The final stage matches the upstream TensorFold image: CUDA
# runtime base + NCCL >= 2.30 + verbs providers.
CUDA_DEVEL_TAG=13.0.1-devel-ubuntu24.04
CUDA_TAG=13.0.1-runtime-ubuntu24.04
NCCL_APT_VERSION=2.32.3-1+cuda13.4
ZIG_VERSION=0.17.0
TARGET_SM=121
# tokenizers wheel for the in-image rank-cache preparation helper (node_inputs.sh)
TOKENIZERS_VERSION=0.21.1
